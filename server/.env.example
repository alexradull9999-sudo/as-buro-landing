# Set these in Timeweb runtime variables. Never commit real credentials.
SITE_ORIGIN=https://a-s-buro.ru
SMTP_HOST=
SMTP_PORT=465
# Credentials of a separate website sender, not the recipient's mailbox.
SMTP_USER=
SMTP_PASS=
# Usually the same mailbox as SMTP_USER. One address, without a display name.
MAIL_FROM=
# Recipient is fixed by default; change only on the owner's instruction.
LEADS_TO=offer@a-s-buro.com
PORT=8080
# 0 uses the socket address. Set only after confirming the proxy topology.
TRUST_PROXY_HOPS=0
# Stable random value (at least 32 characters) preserves tokens across restarts.
# Run one replica: rate limits and duplicate suppression are held in memory.
# If empty, a new in-memory secret is generated on each restart.
FORM_SECRET=
